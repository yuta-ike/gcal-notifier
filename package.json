{
  "name": "gcal-notifier",
  "version": "1.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists .env index.tsx",
    "start": "tsx --env-file-if-exists .env index.tsx",
    "test": "GOOGLE_CLIENT_ID=test-client GOOGLE_CLIENT_SECRET=test-secret GOOGLE_CALENDAR_ID=test-calendar CRON_SECRET=test-cron-secret node --import tsx --test 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "knip": "knip",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "fix": "pnpm lint:fix && pnpm fmt"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "hono": "catalog:",
    "mongodb": "catalog:",
    "sanitize-html": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/sanitize-html": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.4.1"
}
