# App
PORT=3000
BASE_URL=http://localhost:3000
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=gcal-notifier
CRON_SECRET=replace-with-a-cron-secret
APP_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Google Calendar OAuth (separate from oauth2-proxy login)
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_CALENDAR_ID=

# Slack bot token
SLACK_BOT_TOKEN=

# In development, headers can be simulated without oauth2-proxy.
LOCAL_USER_ID=local-user
LOCAL_USER_EMAIL=local@example.com

# oauth2-proxy (required by docker compose)
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
OAUTH2_PROXY_COOKIE_SECRET=
